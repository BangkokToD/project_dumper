{
  "ignore_hidden": true,
  "include_env": false,
  "max_file_size": 524288,
  "encoding": "utf-8",
  "errors_policy": "replace",
  "follow_symlinks": false,
  "ignore_dirs": [
    ".git",
    "__pycache__",
    "node_modules",
    ".venv",
    "venv",
    ".idea",
    ".vscode",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    "build",
    "dist",
    "target",
    ".cache"
  ],
  "ignore_files": [
    ".gitignore",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.ico",
    "*.pdf",
    "*.zip",
    "*.tar",
    "*.gz",
    "*.7z",
    "*.rar",
    "*.mp3",
    "*.wav",
    "*.ogg",
    "*.flac",
    "*.mov",
    "*.mp4",
    "*.avi",
    "*.mkv",
    "*.exe",
    "*.dll",
    "*.so",
    "*.bin",
    "*.otf",
    "*.ttf",
    "*.woff",
    "*.woff2",
    "*.pyc",
    "*.pyo",
    "*.class",
    "*.o",
    "*.a",
    "*.dylib",
    "*.sqlite*",
    "*.db"
  ],
  "dirs_first_in_tree": true,
  "binary_threshold": 0.3,
  "detect_encoding": true,
  "output_format": "md",
  "theme": "dark",
  "diff_group_modifier": "Shift",
  "diff_copy_flash_duration_ms": 800,
  "list_scan": {
    "star_is_recursive": false,
    "ignore_filters": false,
    "expand_dir_match": false
  },
  "text_cleaner": {
    "preserve_separator_spacing": true
  }
}